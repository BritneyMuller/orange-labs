---
import BaseLayout from '../../layouts/BaseLayout.astro';
import blog from '../../data/blog.json';

interface Post {
  title: string;
  excerpt: string;
  date: string;
  href: string;
  type: 'substack' | 'custom';
  badge?: string;
  image?: string;
  imageAlt?: string;
}

interface CustomPost {
  title: string;
  excerpt: string;
  date: string;
  href: string;
  badge?: string;
  image?: string;
  imageAlt?: string;
}

async function fetchSubstackPosts(feedUrl: string): Promise<Post[]> {
  try {
    const res = await fetch(feedUrl, { signal: AbortSignal.timeout(8000) });
    if (!res.ok) return [];
    const xml = await res.text();
    const items = [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)];
    return items.map((match) => {
      const block = match[1];
      const title =
        (block.match(/<title>(?:<!\[CDATA\[)?([\s\S]*?)(?:\]\]>)?<\/title>/) || [])[1]?.trim() ??
        'Untitled';
      const link =
        (block.match(/<link>([\s\S]*?)<\/link>/) || [])[1]?.trim() ?? blog.substackUrl;
      const pubDate = (block.match(/<pubDate>([\s\S]*?)<\/pubDate>/) || [])[1]?.trim();
      const descriptionRaw =
        (block.match(/<description>(?:<!\[CDATA\[)?([\s\S]*?)(?:\]\]>)?<\/description>/) || [])[1] ??
        '';
      const plain = descriptionRaw.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
      const excerpt = plain.length > 160 ? `${plain.slice(0, 160)}…` : plain;
      const image =
        (block.match(/<enclosure[^>]*url="([^"]+)"/) || [])[1] ??
        (descriptionRaw.match(/<img[^>]*src="([^"]+)"/) || [])[1];
      return {
        title,
        excerpt,
        date: pubDate ? new Date(pubDate).toISOString() : new Date(0).toISOString(),
        href: link,
        type: 'substack' as const,
        image,
      };
    });
  } catch {
    return [];
  }
}

const substackPosts = (await fetchSubstackPosts(blog.substackFeedUrl)).filter(
  (p) => p.title.trim().toLowerCase() !== 'coming soon',
);
const customPosts: Post[] = (blog.customPosts as CustomPost[]).map((p) => ({
  ...p,
  type: 'custom' as const,
}));
const posts = [...substackPosts, ...customPosts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
---

<BaseLayout title={blog.meta.title} description={blog.meta.description}>
  <header class="hero dotgrid" style="padding-bottom: 3rem">
    <div class="wrap">
      <div class="eyebrow">{blog.eyebrow}</div>
      <h1>{blog.heading}</h1>
      <p class="lede" style="margin-top: 1rem; max-width: 40em">{blog.intro}</p>
    </div>
  </header>

  <section class="on-light">
    <div class="wrap">
      {posts.length === 0 && <p>No posts yet — check back soon.</p>}
      <div class="postgrid">
        {
          posts.map((post) => (
            <a
              class="postcard"
              href={post.href}
              target={post.type === 'substack' ? '_blank' : undefined}
              rel={post.type === 'substack' ? 'noopener noreferrer' : undefined}
            >
              {post.image && <img class="postcard-img" src={post.image} alt={post.imageAlt ?? ''} loading="lazy" />}
              <div class="postcard-body">
                <span class="posttype">{post.type === 'substack' ? 'Substack' : (post.badge ?? 'Article')}</span>
                <h3>{post.title}</h3>
                <p>{post.excerpt}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
